PRODUCT_HUNT_API_URL=https://api.producthunt.com/v2/api/graphql
PRODUCT_HUNT_USER_AGENT=LeadFinder/1.0 (lead-finder-backend)
PRODUCT_HUNT_TIMEOUT=30
PRODUCT_HUNT_MAX_COMPANIES=50
PRODUCT_HUNT_API_TOKEN=

HACKERNEWS_API_URL=https://hn.algolia.com/api/v1/search_by_date
HACKERNEWS_USER_AGENT=LeadFinder/1.0 (lead-finder-backend)
HACKERNEWS_TIMEOUT=30
HACKERNEWS_MAX_COMPANIES=50

YCOMBINATOR_API_BASE=https://yc-oss.github.io/api
YCOMBINATOR_USER_AGENT=LeadFinder/1.0 (lead-finder-backend)
YCOMBINATOR_TIMEOUT=45
YCOMBINATOR_MAX_COMPANIES=50

# Prefer India-linked startups (location / .in domain / India keywords) when ranking.
PREFER_INDIA_STARTUPS=true

# Optional — raises GitHub API rate limits (Settings → Developer settings → Personal access token).
GITHUB_TOKEN=
GITHUB_MAX_COMPANIES=50
GITHUB_MIN_STARS=5
GITHUB_LOOKBACK_DAYS=45

# Comma-separated RSS feed URLs (India-leaning; no API key).
RSS_FEED_URLS=https://inc42.com/feed/,https://yourstory.com/feed/,https://techcrunch.com/tag/india/feed/
RSS_MAX_COMPANIES=40

# Google News RSS queries focused on India (no API key).
GOOGLE_NEWS_FEED_URLS=https://news.google.com/rss/search?q=Indian+startup+launch&hl=en-IN&gl=IN&ceid=IN:en,https://news.google.com/rss/search?q=startup+raises+funding+India&hl=en-IN&gl=IN&ceid=IN:en,https://news.google.com/rss/search?q=new+SaaS+startup+India&hl=en-IN&gl=IN&ceid=IN:en
GOOGLE_NEWS_MAX_COMPANIES=40

# Reddit app credentials (required for reddit source). Create at https://www.reddit.com/prefs/apps
# Choose "script" or "installed app"; use the client id under the app name and the secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=indianstartups,developersIndia,startups,SideProject,indiehackers,Entrepreneur
REDDIT_MAX_COMPANIES=40
REDDIT_USER_AGENT=LeadFinder/1.0 by your_reddit_username

QUALIFICATION_PASSING_SCORE=60
# Legacy rule-name list is ignored by the scoring engine; weights live in
# app/qualification/weights.py. Kept for backward-compatible env files.
QUALIFICATION_ENABLED_RULES=
# Minimum outbound lead score required to enqueue email (0-100).
# Prefer the value near LEAD_GENERATION_LIMIT below.

# Keep only the newest N daily YYYY-MM-DDlogs.txt pipeline log files.
LOG_RETENTION_DAYS=7

CRAWLER_TIMEOUT=20
CRAWLER_MAX_REDIRECTS=5
CRAWLER_MAX_HTML_SIZE=2000000
CRAWLER_USER_AGENT=LeadFinderBot/1.0 (+https://lead-finder.local)

TECHNOLOGY_MINIMUM_CONFIDENCE=50
TECHNOLOGY_ENABLED_TECHNOLOGIES=*

MOBILE_DETECTION_ENABLED=true
MOBILE_DETECTION_MINIMUM_CONFIDENCE=0.5

ENABLED_SOURCES=producthunt,hackernews,ycombinator,github,rss,googlenews,reddit
# Give multi-source collection enough time (7 collectors).
COLLECTION_TIMEOUT=300
MAX_COLLECTORS=10
# Cap companies processed per daily/manual run (0 = unlimited).
LEAD_GENERATION_LIMIT=80

# Outbound queue eligibility (lower = more emails queued).
MIN_LEAD_SCORE=50


SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0
COLLECT_CRON=0 * * * *
VALIDATION_CRON=30 * * * *
CLEANUP_CRON=0 2 * * *
MAX_JOB_RUNTIME=600

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.45
OLLAMA_MAX_TOKENS=512

# SMTP delivery (Step 40). Keep SMTP_ENABLED=false until production credentials are set.
# The 09:00 scheduler never sends email — only READY_TO_SEND items can be sent manually.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=true
SMTP_REPLY_TO=
SMTP_TIMEOUT_SECONDS=30
# Legacy aliases (optional). Prefer SMTP_* above.
SMTP_TLS=true
FROM_EMAIL=
# When true, send path logs and marks SENT without contacting SMTP (local/tests).
DRY_RUN=true